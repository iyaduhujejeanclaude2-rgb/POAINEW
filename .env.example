# Copy to .env and replace all secrets before deployment
POSTGRES_PASSWORD=replace_with_32plus_random_characters
DATABASE_URL=postgresql+psycopg://poai:replace_with_password@db:5432/poai
API_KEY=replace_with_long_random_api_key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPLOAD_DIR=/data/screenshots
MAX_UPLOAD_MB=8
CONFIDENCE_THRESHOLD=0.68
